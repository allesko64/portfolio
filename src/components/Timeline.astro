---
/**
 * Resume-style list, newest first. Projects live in the Work block and on /projects.
 */
interface Entry {
  date: string;
  title: string;
  line: string;
  detail?: string;
  note?: string; // accent margin note, one line
}

const entries: Entry[] = [
  {
    date: '2026',
    title: '3rd place, ChaiCode Hackathon',
    line: 'Out of 300+ participants. Built and shipped a working full-stack system with a team, on a fixed deadline.',
    note: '3rd of 300+',
  },
  {
    date: '2026',
    title: 'ChaiCode cohort',
    line: 'Learning in public, building alongside a cohort.',
  },
  {
    date: '2023 – 2027',
    title: 'B.E. in Computer Science',
    line: 'MVJ College of Engineering, Bengaluru. Graduating May 2027.',
    detail: 'CGPA: 8.7',
  },
];
---

<section class="mt-24 fade-up" aria-labelledby="tl-heading">
  <h2 id="tl-heading" class="chalk text-3xl">So far</h2>

  <div class="relative mt-8 pl-[104px] sm:pl-[120px]">
    {/* vertical chalk line, draws downward when in view */}
    <span
      class="tl-line absolute left-[88px] sm:left-[104px] top-1 bottom-1 w-px bg-chalk/40"
      aria-hidden="true"></span>

    <ul class="space-y-8">
      {
        entries.map((e, i) => (
          <li class="fade-up relative" style={`--delay:${200 + i * 350}ms`}>
            {/* small chalk circle on the line */}
            <span
              class="absolute -left-[20px] sm:-left-[20px] top-[10px] w-2 h-2 rounded-full border border-chalk/70 bg-bg"
              aria-hidden="true"
            />
            <span class="absolute -left-[104px] sm:-left-[120px] top-0 w-[80px] text-[13px] text-muted tl-date transition-colors duration-150">
              {e.date}
            </span>

            <details class="group">
              <summary class="list-none cursor-pointer flex items-start justify-between gap-4 min-h-11 [&::-webkit-details-marker]:hidden">
                <span>
                  <span class="block text-text">{e.title}</span>
                  <span class="block text-sm text-muted">{e.line}</span>
                </span>
                {e.detail && (
                  <span
                    class="shrink-0 text-muted mt-0.5 transition-transform duration-150 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                )}
              </summary>
              {e.detail && <p class="mt-3 text-sm text-muted max-w-[52ch]">{e.detail}</p>}
            </details>

            {e.note && (
              <span class="chalk !text-accent text-lg block mt-1 lg:mt-0 lg:absolute lg:left-full lg:ml-6 lg:top-0 lg:-rotate-3 lg:whitespace-nowrap">
                {e.note}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  li:hover .tl-date,
  li:focus-within .tl-date {
    color: var(--color-accent);
  }
  details:not([open]) summary ~ * {
    display: none;
  }
</style>
