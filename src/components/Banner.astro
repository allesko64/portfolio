---
/**
 * Top-of-home banner: pixel-art night scene (public/banner/banner-poster.png,
 * generated by scripts/banner.py), profile photo bottom-left, caption bottom-right.
 */
import { Picture } from 'astro:assets';
import avatar from '../assets/avatar.jpg';

const caption = "ain't no fun when rabbit got the gun";
---

<section class="relative -mx-5 sm:-mx-10 h-40 sm:h-[220px] overflow-hidden rounded-sm" aria-label="Banner">
  <img
    src="/banner/banner-poster.png"
    alt=""
    width="1280"
    height="320"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover object-[center_bottom] [image-rendering:pixelated]"
    aria-hidden="true"
  />

  {/* dim + fade into the page */}
  <div class="absolute inset-0 bg-black/15 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-b from-transparent to-bg pointer-events-none" aria-hidden="true">
  </div>

  {/* profile photo: bottom-left, where the banner art is kept empty */}
  <Picture
    src={avatar}
    alt="Ayush Sharma"
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    width={96}
    widths={[72, 96, 144, 192]}
    sizes="(min-width: 640px) 96px, 72px"
    quality={82}
    loading="eager"
    decoding="async"
    pictureAttributes={{ class: 'absolute left-4 bottom-4 sm:left-6 sm:bottom-5 z-10 block' }}
    class="block w-[72px] h-[72px] sm:w-24 sm:h-24 rounded-full object-cover ring-2 ring-bg outline outline-1 outline-accent/60 outline-offset-2"
  />

  <p
    class="chalk fade-up absolute right-4 bottom-3 left-[104px] sm:left-auto text-right text-balance text-base sm:text-lg leading-tight text-chalk/80"
    style="--delay:400ms"
  >
    {caption}
  </p>
</section>
